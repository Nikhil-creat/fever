# Copy to .env and fill in real values. Never commit the actual .env file.

# Redis connection
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# App
APP_VERSION=1.0.0
MEMORY_THRESHOLD_PCT=90.0

# CORS — set to your GitHub Pages origin in production, e.g.
# https://nikhil-creat.github.io
CORS_ALLOWED_ORIGINS=*

# CI/CD (GitHub Actions repo secrets — do not put real values here)
# KUBE_CONFIG_BASE64=
# GHCR credentials use the built-in GITHUB_TOKEN — no extra secret needed

# Observability
# SLACK_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
